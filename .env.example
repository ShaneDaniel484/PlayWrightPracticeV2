# ---- Environment ----
# Target environment: local | staging | production
ENV=local

# ---- Browser ----
# Browser to run tests: chromium | firefox | webkit | all
BROWSER=chromium

# ---- Execution ----
# Run in headless mode (true | false)
HEADLESS=false
# Number of workers (default: auto)
WORKERS=auto
# Retries for failed tests
RETRIES=0

# ---- Reporting ----
# Reporters: html | list | json | junit | allure | github
REPORTER=html

# ---- Trace & Video ----
TRACE=retain-on-failure
VIDEO=retain-on-failure
SCREENSHOT=only-on-failure

# ---- Timeouts (ms) ----
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
ACTION_TIMEOUT=15000

# ---- Test Data ----
HEROKU_BASE_URL=https://the-internet.herokuapp.com
HEROKU_USERNAME=tomsmith
HEROKU_PASSWORD=SuperSecretPassword!
